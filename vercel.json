{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "api/pay.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/pay", "dest": "/api/pay.js" },
    { "src": "/(.*\\.(jpg|jpeg|png|gif|svg|ico|css|js))", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
